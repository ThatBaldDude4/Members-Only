<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>
<body>
    <h1>Message Board Page</h1>

    <a href="/membership">Update Membership</a>
    <% if (locals.user) { %>
        <a href="/posts/new">New Post</a>
    <% }; %>
    <a href="/logout"><%= locals?.user ? "Logout" : "Login" %></a>

    <% if (locals.posts) { %> 
        <% posts.forEach(post => { %>

            <div>
                <h3><%= post.title %></h3>
                <p>Author: <%= user?.member_status ? post.user.username : "******" %></p>
                <p><%= post.message %></p>
                <% if (user?.member_status) { %>
                    <p>
                       <%= 
                        new Date(post.created_at).toLocaleString("en-US", {
                            month: "short",
                            day: "numeric",
                            year: "numeric",
                            hour: "numeric",
                            minute: "2-digit"
                        })
                       %> 
                    </p>    
                <% }; %>
            </div>

            <% if (user?.member_status === "admin") { %>
                <form action="/delete-post/<%= post.id %>" method="POST">
                    <button type="submit">DELETE POST</button>
                </form>
            <% } %>

        <% }); %>
    <% } %>
</body>
</html>