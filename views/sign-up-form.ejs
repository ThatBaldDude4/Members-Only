<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
</head>
<body>
    <h1>Sign Up</h1>

    <% if (locals.errors && errors.length > 0) { %>
        <ul>
            <% errors.forEach((error) => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    <form action="/sign-up" method="POST">
        <label>
            First Name:
            <input id="first-name" name="first_name" type="text" value="<%= locals.form_data ? form_data.first_name : "" %>" />
        </label>
        <label>
            Last Name:
            <input id="last-name" name="last_name" type="text" value="<%= locals.form_data ? form_data.last_name : "" %>" />
        </label>
        <label>
            Email:
            <input id="email" name="email" type="email" value="<%= locals.form_data ? form_data.email : "" %>" />
        </label>
        <label>
            Username:
            <input id="username" name="username" type="text" value="<%= locals.form_data ? form_data.username : "" %>" />
        </label>
        <label>
            Password:
            <input id="password" name="password" type="password" value="<%= locals.form_data ? form_data.password : "" %>" />
        </label>
        <label>
            Confirm Password:
            <input id="confirm-password" name="confirm_password" type="password" />
        </label>
        <button type="submit">Sign Up</button>
    </form>
</body>
</html>